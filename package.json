{
  "name": "dsh-datapilot",
  "description": "DataPilot 数据工作台：在 DSH 侧边栏常驻一个数据分析面板，查看多工作区、多数据集的分析图表、数据分布与深度学习模型结构图。",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "main": "lib/host/index.js",
  "exports": {
    ".": {
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "assets/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "cordis",
    "data",
    "dataset",
    "chart",
    "data-analysis",
    "visualization",
    "onnx",
    "model-architecture",
    "machine-learning",
    "ml",
    "training",
    "数据分析",
    "可视化",
    "机器学习"
  ],
  "license": "MIT",
  "author": "xiduo-wang <1253442021@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiduo-wang/dsh-datapilot.git"
  },
  "homepage": "https://github.com/xiduo-wang/dsh-datapilot#readme",
  "bugs": {
    "url": "https://github.com/xiduo-wang/dsh-datapilot/issues"
  },
  "dependencies": {
    "hyparquet": "^1.33.0",
    "hyparquet-compressors": "^1.1.3",
    "xlsx": "^0.18.5"
  }
}
